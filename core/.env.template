# =============================================================================
# ENVIRONMENT VARIABLES — Digital Brain v2
# Copy file ini menjadi .env dan isi dengan keys kamu.
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# 1. PORT CONFIGURATIONS (Internal)
# ─────────────────────────────────────────────────────────────────────────────
AI_ROUTER_PORT=8080
QWEN_PORT=11434
STORAGE_MANAGER_PORT=8090
WEB_PORT=3000
MONITOR_PORT=19999

# ─────────────────────────────────────────────────────────────────────────────
# 2. MONITORING & LOGGING
# ─────────────────────────────────────────────────────────────────────────────
MONITOR_INTERVAL=10
LOG_MAX_SIZE_GB=30

# ─────────────────────────────────────────────────────────────────────────────
# 3. AI PROVIDERS (MULTI-ACCOUNT)
# Pisahkan dengan koma (,) jika punya banyak akun/key untuk satu provider.
# Contoh: GEMINI_API_KEYS=key_akun_1,key_akun_2,key_akun_3
# Router akan otomatis load balance dan failover antar akun.
# ─────────────────────────────────────────────────────────────────────────────
GROQ_API_KEYS=gsk_xxx
CEREBRAS_API_KEYS=
OPENROUTER_API_KEYS=sk-or-v1-xxx
GEMINI_API_KEYS=AIzaSy_xxx,AIzaSy_yyy,AIzaSy_zzz
DEEPSEEK_API_KEYS=sk-xxx
MISTRAL_API_KEYS=
ANTHROPIC_API_KEYS=
CLOUDFLARE_API_KEYS=
XAI_API_KEYS=
OPENAI_API_KEYS=

# ─────────────────────────────────────────────────────────────────────────────
# 4. LOCAL AI (QWEN)
# ─────────────────────────────────────────────────────────────────────────────
QWEN_MODEL_SIZE=1.5B
QWEN_ACCESS_SECRET=local_secure_key_123

# ─────────────────────────────────────────────────────────────────────────────
# 5. TELEGRAM ALERT BOT
# Dapatkan Token dari @BotFather dan Chat ID dari @userinfobot
# ─────────────────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIjkLMNopQRstUvwXyz
TELEGRAM_CHAT_ID=12345678

# ─────────────────────────────────────────────────────────────────────────────
# 6. CLOUD STORAGE (RCLONE)
# Catatan: rclone mensupport unlimited akun secara native.
# Konfigurasi aslinya disimpan di ~/.config/rclone/rclone.conf (jangan disebar).
# ─────────────────────────────────────────────────────────────────────────────
STORAGE_MAX_UPLOAD_THREADS=4
STORAGE_CHUNK_SIZE_MB=8

# ─────────────────────────────────────────────────────────────────────────────
# 7. OSINT SCRAPER
# ─────────────────────────────────────────────────────────────────────────────
# Jika punya proxy, isi di sini agar tidak kena block saat scraping
HTTP_PROXY=
HTTPS_PROXY=
# Custom Search API (Opsional untuk scraping akurat)
GOOGLE_CSE_ID=
GOOGLE_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# 8. SYSTEM SECRETS (Jangan diubah setelah deploy)
# ─────────────────────────────────────────────────────────────────────────────
JWT_SECRET=rahasia_jwt_123
POSTGRES_PASSWORD=rahasia_db_123
